# Copy to .env and adjust as needed. Sensible defaults are baked into
# settings.py so the app runs with none of this set.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. docker-compose sets this to Postgres.
# DATABASE_URL=postgres://ops:ops@localhost:5432/ops_dashboard

# Leave unset to use the in-memory channel layer (fine for a single
# `daphne` process). docker-compose sets this to the Redis service.
# REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret POS terminals use to call POST /api/transactions/.
POS_INGEST_TOKEN=dev-pos-token-change-me
